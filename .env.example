# ─────────────────────────────────────────────────────────────
# subcult environment
# Copy to .env.local and fill in what you have. EVERY key is optional:
# a missing key disables its feature (and hides that UI section)
# instead of crashing, so you can demo with zero setup.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployed app (used for OG images and share links).
# Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ── LLM: niche profile generation + vibe check blurbs ────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Supabase: Postgres + Auth (Google + magic link) ──────────
# Supabase dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_…). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Supabase → Connect → Connection string.
# App runtime: the "Transaction pooler" URI (port 6543), best for serverless.
DATABASE_URL=
# Migrations only (pnpm db:migrate): the "Session pooler" URI (port 5432)
# or the direct connection. Transaction mode can't run DDL migrations reliably.
DIRECT_URL=

# ── Upstash Redis: fetcher cache + rate limiting ─────────────
# https://console.upstash.com → Redis → your DB → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Spotify Web API (Client Credentials flow, /search only) ──
# https://developer.spotify.com/dashboard → Create app → Settings
# Dev-mode apps need the owner on Premium. Without keys, the Sounds tab
# falls back to Spotify search + artist deep links.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── YouTube Data API v3 ──────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → enable
# "YouTube Data API v3" → Credentials → Create API key
YOUTUBE_API_KEY=

# ── PostHog product analytics ────────────────────────────────
# https://app.posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# ── Shopping (optional) ──────────────────────────────────────
# Amazon storefront for shop links (default amazon.com; e.g. amazon.in)
AMAZON_DOMAIN=
# Amazon Associates tag appended to Amazon search links, e.g. yourtag-21
AMAZON_AFFILIATE_TAG=

# ── Budget guardrails ────────────────────────────────────────
# Max new LLM niche generations per UTC day, across all users (default 30).
# Per-IP limit (10/day) applies on top. Cached and preset niches are free.
LLM_DAILY_GENERATION_CAP=
# Password for /admin (HTTP Basic auth; any username). Admin 404s when unset.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET=
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes. Set it in
# Vercel → Settings → Environment Variables (any long random string).
CRON_SECRET=

# ── Trend engine (pnpm trends:refresh, Vercel Cron on the 1st & 15th) ──
# Days before a trending niche is archived (still reachable by URL, off Explore). Default 42.
TREND_TTL_DAYS=
# Hard USD cap per trend run; the run aborts before exceeding it. Default 0.25.
TREND_RUN_MAX_COST_USD=
# "true" to let Claude use its web search tool for extra signals (≤5 searches,
# $10/1K searches + tokens). Only used if the Models API reports support. Default false.
TREND_WEB_SEARCH=
