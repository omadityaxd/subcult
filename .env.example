# ─────────────────────────────────────────────────────────────
# subcult environment
# Copy to .env.local and fill in what you have. EVERY key is optional:
# a missing key disables its feature (and hides that UI section)
# instead of crashing, so you can demo with zero setup.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployed app (used for OG images and share links).
# Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ── LLM: niche profile generation + vibe check blurbs ────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Supabase: Postgres + Auth (Google + magic link) ──────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Connection string.
# App runtime: the "Transaction pooler" URI (port 6543), best for serverless.
DATABASE_URL=
# Migrations only (pnpm db:migrate): the "Session pooler" URI (port 5432)
# or the direct connection. Transaction mode can't run DDL migrations reliably.
DIRECT_URL=

# ── Upstash Redis: fetcher cache + rate limiting ─────────────
# https://console.upstash.com → Redis → your DB → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Spotify Web API (Client Credentials flow) ────────────────
# https://developer.spotify.com/dashboard → Create app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── YouTube Data API v3 ──────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → enable
# "YouTube Data API v3" → Credentials → Create API key
YOUTUBE_API_KEY=

# ── Reddit (optional) ────────────────────────────────────────
# OAuth app from https://www.reddit.com/prefs/apps ("script" type).
# Without these, the Reddit fetcher falls back to cached public JSON.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── PostHog product analytics ────────────────────────────────
# https://app.posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# ── Shopping (optional) ──────────────────────────────────────
# Amazon Associates tag appended to Amazon search links, e.g. yourtag-21
AMAZON_AFFILIATE_TAG=
